{
  "name": "maplibre-gl-shader-layer",
  "private": false,
  "version": "0.1.2",
  "type": "module",
  "types": "dist-lib/maplibre-gl-shader-layer.d.ts",
  "exports": {
    ".": {
      "import": "./dist-lib/maplibre-gl-shader-layer.js",
      "types": "./dist-lib/maplibre-gl-shader-layer.d.ts"
    }
  },
  "author": "Jonathan Lurie",
  "homepage": "https://github.com/geoblocks/maplibre-gl-shader-layer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/geoblocks/maplibre-gl-shader-layer.git"
  },
  "keywords": [
    "maplibre",
    "webgl",
    "custom-layer",
    "dataviz"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "rm -rf ./dist-lib/* && tsc && vite build -c vite.config-lib.ts",
    "preview": "vite preview",
    "biome": "biome check --max-diagnostics=1000",
    "biome:fix": "biome check --max-diagnostics=1000 --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/node": "^25.0.3",
    "@types/three": "^0.166.0",
    "basemapkit": "^0.5.0",
    "husky": "^9.1.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "color": "^5.0.3",
    "maplibre-gl": "^5.15.0",
    "pmtiles": "^4.3.0",
    "quick-lru": "^7.3.0",
    "three": "^0.182.0"
  }
}
